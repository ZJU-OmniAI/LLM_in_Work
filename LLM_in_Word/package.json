{
  "name": "llm-in-word",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "LLM_in_Word — Review and apply AI edits in desktop Microsoft Word with your local Claude Code or Codex CLI.",
  "scripts": {
    "server": "node server/server.js",
    "test": "node tools/test-format.js && node tools/test-table.js && node --test tools/test-backend.js tools/test-ui.js tools/test-platform.js",
    "test:live": "node tools/test-server.js",
    "test:live:codex": "node tools/test-server.js --codex",
    "preview": "node tools/platform.js preview",
    "update": "node tools/platform.js update",
    "setup": "node tools/platform.js install"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "keywords": [
    "word-addin",
    "office-js",
    "claude-code",
    "codex",
    "writing-assistant"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZJU-OmniAI/LLM_in_Work.git",
    "directory": "LLM_in_Word"
  },
  "homepage": "https://github.com/ZJU-OmniAI/LLM_in_Work/tree/main/LLM_in_Word#readme",
  "bugs": {
