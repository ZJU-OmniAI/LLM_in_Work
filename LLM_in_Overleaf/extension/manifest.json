{
  "manifest_version": 3,
  "name": "LLM_in_Overleaf",
  "version": "0.8.2",
  "description": "在 Overleaf 编辑器里选中 LaTeX 让 AI 改写：整份文件做上下文，可附加项目其他文件和本地 PDF/图片，diff 预览、一键应用。后端接本机 Claude Code / Codex CLI，可选模型和 effort。",
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.overleaf.com/project/*",
        "https://overleaf.com/project/*",
        "https://cn.overleaf.com/project/*"
      ],
      "js": [
        "content/bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.overleaf.com/project/*",
        "https://overleaf.com/project/*",
        "https://cn.overleaf.com/project/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "打开/收起 LLM_in_Overleaf 面板"
    }
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LLM_in_Overleaf 写作助手"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
