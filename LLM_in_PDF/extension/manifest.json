{
  "manifest_version": 3,
  "name": "LLM_in_PDF",
  "version": "0.9.2",
  "description": "__MSG_extDescription__",
  "key": "",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "nativeMessaging",
    "declarativeNetRequestWithHostAccess",
    "clipboardWrite",
    "activeTab",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://arxiv.org/*",
        "*://*.arxiv.org/*"
      ],
      "js": [
        "vendor/katex/katex.min.js",
        "vendor/markdown-it/markdown-it.min.js",
        "content/markdown.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/katex/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "reader/reader.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_actionTitle__"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "homepage_url": "https://github.com/ZJU-OmniAI/LLM_in_Work/tree/main/LLM_in_PDF",
  "default_locale": "en"
}
