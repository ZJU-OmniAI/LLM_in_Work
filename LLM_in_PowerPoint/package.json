{
  "name": "llm-in-powerpoint",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "LLM_in_PowerPoint — Review and apply AI edits to slides in desktop Microsoft PowerPoint with your local Claude Code or Codex CLI.",
  "scripts": {
    "server": "node server/server.js",
    "test": "node --test tools/test-edits.js tools/test-deck.js tools/test-format.js tools/test-table.js tools/test-i18n.js tools/test-ui.js tools/test-backend.js tools/test-platform.js tools/test-prompt.js",
    "test:live": "node tools/test-server.js",
    "test:live:codex": "node tools/test-server.js --codex",
    "preview": "node tools/platform.js preview",
    "update": "node tools/platform.js update",
    "setup": "node tools/platform.js install",
    "uninstall": "node tools/platform.js uninstall"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "keywords": [
    "powerpoint-addin",
    "office-js",
    "claude-code",
    "codex",
    "presentation",
    "writing-assistant"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZJU-OmniAI/LLM_in_Work.git",
    "directory": "LLM_in_PowerPoint"
  },
  "homepage": "https://github.com/ZJU-OmniAI/LLM_in_Work/tree/main/LLM_in_PowerPoint#readme",
  "bugs": {
    "url": "https://github.com/ZJU-OmniAI/LLM_in_Work/issues"
  }
}
